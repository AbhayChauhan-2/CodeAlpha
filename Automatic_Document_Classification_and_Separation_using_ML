      "source": [
        "\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "# Sample training documents\n",
        "documents = [\n",
        "    \"Python programming and artificial intelligence\",\n",
        "    \"Machine learning and neural networks\",\n",
        "    \"Football match and cricket tournament\",\n",
        "    \"Players scored goals in the match\",\n",
        "    \"Healthy food and regular exercise\",\n",
        "    \"Doctors provide medical treatment\"\n",
        "]\n",
        "\n",
        "labels = [\n",
        "    \"Technology\",\n",
        "    \"Technology\",\n",
        "    \"Sports\",\n",
        "    \"Sports\",\n",
        "    \"Health\",\n",
        "    \"Health\"\n",
        "]\n",
        "\n",
        "# Build the classification pipeline\n",
        "model = Pipeline([\n",
        "    (\"tfidf\", TfidfVectorizer()),\n",
        "    (\"classifier\", MultinomialNB())\n",
        "])\n",
        "\n",
        "# Train the classifier\n",
        "model.fit(documents, labels)\n",
        "\n",
        "# Classify new documents\n",
        "new_documents = [\n",
        "    \"Deep learning and computer programming\",\n",
        "    \"The team won the football match\",\n",
        "    \"Exercise improves physical health\"\n",
        "]\n",
        "\n",
        "predictions = model.predict(new_documents)\n",
        "\n",
        "print(\"Document Classification Results:\\n\")\n",
        "\n",
        "for document, category in zip(new_documents, predictions):\n",
        "    print(\"Document:\", document)\n",
        "    print(\"Category:\", category)\n",
        "    print(\"-\" * 50)\n",
        "\n",
        "# Separate documents according to their predicted category\n",
        "separated_documents = {}\n",
        "\n",
        "for document, category in zip(new_documents, predictions):\n",
        "    separated_documents.setdefault(category, []).append(document)\n",
        "\n",
        "print(\"\\nSeparated Documents:\")\n",
        "\n",
        "for category, docs in separated_documents.items():\n",
        "    print(f\"\\n{category}:\")\n",
        "    for doc in docs:\n",
        "        print(\"-\", doc)"
      ]
